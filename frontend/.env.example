# Base URL of the Hande High School CMS/public API (Laravel).
# Include the /api suffix. In production this becomes the deployed backend origin.
VITE_API_URL=http://localhost:8000/api

# Public site URL (canonical, Open Graph, sitemap). Registered domain: www.handehigh.co.zw
# TODO: CONFIRM production site URL before deploy.
VITE_SITE_URL=https://www.handehigh.co.zw

# CMS admin panel (Filament) link shown in the site header.
# Defaults to the API origin + /admin when omitted.
VITE_ADMIN_URL=http://localhost:8000/admin

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave blank to disable analytics.
VITE_GA4_ID=

# Google Search Console verification token (the content value of google-site-verification).
# Leave blank to skip the verification meta tag.
VITE_GSC_VERIFICATION=
